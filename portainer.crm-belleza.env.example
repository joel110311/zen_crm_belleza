APP_DOMAIN=crm-belleza.example.com
POSTGRES_DB=zencrm
AUTH_URL=https://crm-belleza.example.com
APP_BASE_URL=https://crm-belleza.example.com
WHATSAPP_WEBHOOK_BASE_URL=https://crm-belleza.example.com

POSTGRES_PASSWORD=replace-with-a-long-random-password
WUZAPI_DB_PASSWORD=replace-with-a-different-random-password
WUZAPI_ADMIN_TOKEN=replace-with-a-long-random-token
WUZAPI_USER_TOKEN=replace-with-a-different-random-token
BOT_MESSAGE_SECRET=replace-with-a-third-random-token
WUZAPI_GLOBAL_ENCRYPTION_KEY=replace-with-a-long-random-key
WUZAPI_GLOBAL_HMAC_KEY=replace-with-a-different-random-key
WHATSAPP_INSTANCE_NAME=zen-crm-belleza
SESSION_DEVICE_NAME=Zen CRM Belleza

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
INITIAL_ADMIN_NAME=Admin Belleza
AUTH_SECRET=replace-with-at-least-64-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes in base64 (example command: openssl rand -base64 32)
GOOGLE_TOKEN_ENCRYPTION_KEY=
PUBLIC_SUPPORT_EMAIL=

ALLOW_ENV_AI_FALLBACK=false
OPENAI_API_KEY=
GEMINI_API_KEY=

META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_TECH_PROVIDER_SOLUTION_ID=
META_GRAPH_API_VERSION=v26.0
META_WHATSAPP_REGISTRATION_PIN=
META_WEBHOOK_VERIFY_TOKEN=

# Plataforma multitenant. Mantén las tres banderas en false hasta migrar el
# control plane y probar el provisionador con una base tenant limpia.
CONTROL_POSTGRES_DB=zencrm_control
CONTROL_POSTGRES_USER=zencrm_control_runtime
CONTROL_POSTGRES_PASSWORD=replace-with-a-different-long-random-password
CONTROL_DATABASE_URL=postgresql://zencrm_control_runtime:replace-with-a-different-long-random-password@zen-crm-db:5432/zencrm_control
TENANT_POSTGRES_ADMIN_URL=postgresql://zencrm:replace-with-a-long-random-password@zen-crm-db:5432/postgres
CONTROL_DATABASE_REQUIRE_LEAST_PRIVILEGE=true
TENANT_POSTGRES_CLUSTER_KEY=primary
# Genera con: openssl rand -base64 32
TENANT_CREDENTIALS_ENCRYPTION_KEY=
TENANT_CREDENTIALS_KEY_VERSION=1
TENANT_TRIAL_DAYS=7
PROVISIONER_POLL_SECONDS=15
MULTITENANT_RUNTIME_ENABLED=false
MULTITENANT_AUTH_ENABLED=false
MULTITENANT_PUBLIC_SIGNUP_ENABLED=false
MULTITENANT_INVITATIONS_ENABLED=false
MULTITENANT_PUBLIC_PORTAL_ENABLED=false
MULTITENANT_CHANNELS_ENABLED=false
MULTITENANT_PRIVATE_STORAGE_ENABLED=false
SECURITY_HASH_SALT=
CHANNEL_STATE_SIGNING_SECRET=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_EXPECTED_HOSTNAME=app.synapselogik.com
RESEND_API_KEY=
EMAIL_FROM=SynapseLogik CRM <soporte@synapselogik.com>
EMAIL_REPLY_TO=contacto@synapselogik.com

# Canales por tenant. Define la URL pública definitiva antes de activar Meta; para WuzAPI,
# cada usuario conectado recibe el HMAC de esta plataforma y una ruta opaca independiente.
MULTITENANT_WUZAPI_BASE_URL=
MULTITENANT_WUZAPI_WEBHOOK_HMAC_KEY=
TENANT_WORKER_POLL_SECONDS=10
TENANT_WORKER_STALE_SECONDS=300
TENANT_WORKER_MAX_DRAIN=100

# Almacenamiento S3 privado (MinIO, Cloudflare R2, Backblaze B2 o AWS S3). No uses un bucket
# público. `TENANT_STORAGE_S3_FORCE_PATH_STYLE=true` funciona con MinIO y R2.
TENANT_STORAGE_S3_ENDPOINT=
TENANT_STORAGE_S3_REGION=us-east-1
TENANT_STORAGE_S3_BUCKET=
TENANT_STORAGE_S3_ACCESS_KEY_ID=
TENANT_STORAGE_S3_SECRET_ACCESS_KEY=
TENANT_STORAGE_S3_SESSION_TOKEN=
TENANT_STORAGE_S3_FORCE_PATH_STYLE=true
TENANT_STORAGE_REQUIRE_ANTIVIRUS=false
TENANT_STORAGE_MAX_UPLOAD_BYTES=26214400

TZ=America/Mexico_City
STARTUP_DB_MAX_ATTEMPTS=20
STARTUP_DB_RETRY_MS=5000
